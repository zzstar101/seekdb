select ai_complete('prompt_regression', ai_prompt('{0}{0}{0}{0}', 'abcdefghijklmnop'), '{}') = concat('mock:', repeat('abcdefghijklmnop', 4)) as repeated_ok;
repeated_ok
1
select ai_complete('prompt_regression', ai_prompt('{0}/{1}/{0}', '{1}', 'x'), '{}') = 'mock:{1}/x/{1}' as literal_argument_ok;
literal_argument_ok
1
select ai_complete('prompt_regression', ai_prompt('outer {0}', ai_prompt('inner {0}', '世界')), '{}') = 'mock:outer inner 世界' as nested_ok;
nested_ok
1
select ai_complete('prompt_regression', ai_prompt('{0}|{1}', json_array(1, json_extract('true', '$')), json_object('k', 2)), '{}') = 'mock:[1, true]|{"k": 2}' as json_ok;
json_ok
1
