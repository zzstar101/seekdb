# Distinct binary-collated character keys must not share a queue identity.
connection default;
--disable_warnings
drop database if exists ai_column_key_identity;
--enable_warnings
create database ai_column_key_identity;
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('key_identity_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('key_identity_model');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('key_identity_model', '{"type":"completion","model_name":"mock-complete"}');
# No model call is allowed: every business write below is rolled back.
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('key_identity_ep', '{"ai_model_name":"key_identity_model","url":"http://127.0.0.1:19128/v1/chat/completions","access_key":"test","provider":"openai"}');
create table ai_column_key_identity.docs (
  id varchar(20) character set utf8mb4 collate utf8mb4_bin primary key,
  content varchar(100),
  tags json AI COLUMN (AI_COMPLETE('key_identity_model', content)) WITH (sync_mode='async')
);
start transaction;
insert into ai_column_key_identity.docs(id,content) values ('a','lower'),('A','upper');
select count(*) as distinct_business_keys from ai_column_key_identity.docs;
let $task_count = query_get_value(SELECT count(*) AS n FROM oceanbase.__all_ai_column_task WHERE table_id = (SELECT t.table_id FROM oceanbase.__all_table t JOIN oceanbase.__all_database d ON d.database_id=t.database_id WHERE d.database_name='ai_column_key_identity' AND t.table_name='docs'), n, 1);
if ($task_count != 2)
{
  --die distinct VARCHAR binary-collated keys collided in the AI task table
}
select count(*) as distinct_queue_keys from oceanbase.__all_ai_column_task
where table_id = (select t.table_id from oceanbase.__all_table t join oceanbase.__all_database d
on d.database_id=t.database_id where d.database_name='ai_column_key_identity' and t.table_name='docs');
rollback;
select count(*) as rolled_back_business_keys from ai_column_key_identity.docs;
drop database ai_column_key_identity;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('key_identity_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('key_identity_model');
