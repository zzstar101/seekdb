drop database if exists ai_column_write_guard;
create database ai_column_write_guard;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('guard_complete_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('guard_complete');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('guard_complete',
'{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('guard_complete_ep',
'{"ai_model_name":"guard_complete","url":"http://127.0.0.1:19133/v1/chat/completions","access_key":"guard-key","provider":"openai","request_model_name":"mock-complete"}');
drop table if exists ai_column_write_guard.docs;
Warnings:
Note	1051	Unknown table 'ai_column_write_guard.docs'
create table ai_column_write_guard.docs(
id bigint primary key,
title varchar(100),
content varchar(200),
tags json AI COLUMN (
AI_COMPLETE('guard_complete', concat('Classify: ', content))
) WITH (sync_mode='async', max_retries=2)
);
drop table if exists ai_column_write_guard.forged;
Warnings:
Note	1051	Unknown table 'ai_column_write_guard.forged'
create table ai_column_write_guard.forged(
id bigint primary key,
fake_ai varchar(100) comment '__ai_column__{"ai_function_name":"AI_COMPLETE"}'
);
