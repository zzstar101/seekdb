ERROR HY000: AI column has unfinished tasks for table_id=<table_id>, column_id=<column_id>
update ai_column_strict_regression.docs set title = title where result is null and 0;
ERROR HY000: AI column has unfinished tasks for table_id=<table_id>, column_id=<column_id>
delete from ai_column_strict_regression.docs where result is null and 0;
ERROR HY000: AI column has unfinished tasks for table_id=<table_id>, column_id=<column_id>
update ai_column_strict_regression.docs set title = title where id = 999;
delete from ai_column_strict_regression.docs where id = 999;
set @ai_column_internal_write = 1;
execute strict_cached using @strict_id;
ERROR HY000: AI column has unfinished tasks for table_id=<table_id>, column_id=<column_id>
