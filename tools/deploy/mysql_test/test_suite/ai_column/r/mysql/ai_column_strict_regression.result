select count(*) = 2 as rejected_dml_left_rows_intact from ai_column_strict_regression.docs;
rejected_dml_left_rows_intact
1
deallocate prepare strict_cached;
drop database ai_column_strict_regression;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('strict_regression_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('strict_regression_model');
