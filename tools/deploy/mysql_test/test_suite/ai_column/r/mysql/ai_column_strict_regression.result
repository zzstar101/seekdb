drop database if exists ai_column_strict_regression;
create database ai_column_strict_regression;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('strict_regression_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('strict_regression_model');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('strict_regression_model',
'{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('strict_regression_ep',
'{"ai_model_name":"strict_regression_model","url":"http://127.0.0.1:19129/v1/chat/completions","access_key":"test","provider":"openai","request_model_name":"mock-complete"}');
create table ai_column_strict_regression.docs(
id bigint primary key, content varchar(100), title varchar(100),
result varchar(400) AI COLUMN (AI_COMPLETE('strict_regression_model', content))
WITH (sync_mode='async', max_retries=0),
label varchar(400) AI COLUMN (AI_COMPLETE('strict_regression_model', title))
WITH (sync_mode='async', max_retries=0)
);
insert into ai_column_strict_regression.docs(id, content, title)
values (1, 'first', 'label-one'), (2, 'second', 'label-two');
select 1 = 1 as all_ready;
all_ready
1
set session ai_column_strict_read = on;
prepare strict_cached from 'select result is not null as ready from ai_column_strict_regression.docs where id = ?';
set @strict_id = 2;
execute strict_cached using @strict_id;
ready
1
execute strict_cached using @strict_id;
ready
1
update ai_column_strict_regression.docs set content = 'new-first' where id = 1;
select count(*) = 2 as ordinary_columns_allowed from ai_column_strict_regression.docs;
ordinary_columns_allowed
1
select count(*) = 2 as independent_ready_column_allowed
from ai_column_strict_regression.docs where label is not null;
independent_ready_column_allowed
1
execute strict_cached using @strict_id;
ERROR HY000: AI column has unfinished tasks for table_id=<table_id>, column_id=<column_id>
