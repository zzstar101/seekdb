# INSERT rows whose primary key value is generated by AUTO_INCREMENT (the key
# column is not written by the statement) must still queue AI column tasks, and
# each task must be keyed by the value the executor generated for that row.
#
# Every assertion below is made either inside the statement transaction (where
# the enqueued task rows are visible before the commit) or against the published
# AI column result of the very row that was inserted, so a task queued under a
# fresh/regenerated auto-increment value would fail the case instead of silently
# working.
#
# A table without a primary key (implicit rowkey) is out of the scope of the AI
# column feature: the DML hook only maintains tables with a primary index, so it
# is not covered here.
connection default;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py start 19134
--disable_warnings
drop database if exists ai_column_generated_key;
--enable_warnings
create database ai_column_generated_key;
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('generated_key_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('generated_key_model');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('generated_key_model',
  '{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('generated_key_ep',
  '{"ai_model_name":"generated_key_model","url":"http://127.0.0.1:19134/v1/chat/completions","access_key":"test","provider":"openai","request_model_name":"mock-complete"}');
create table ai_column_generated_key.docs(
  id bigint auto_increment primary key,
  content varchar(100),
  result varchar(400) AI COLUMN (AI_COMPLETE('generated_key_model', content))
    WITH (sync_mode='async', max_retries=0)
);

# 1. One row, auto-increment primary key omitted: the task row key is exactly
#    the key the executor generated for the inserted row.
start transaction;
insert into ai_column_generated_key.docs(content) values ('generated-single');
select count(*) = 1 as generated_key_single_task_key
from oceanbase.__all_ai_column_task task
join ai_column_generated_key.docs row_view
  on task.rowkey_predicate = concat('`id` = ', row_view.id)
where row_view.content = 'generated-single'
  and task.table_id = (select t.table_id from oceanbase.__all_table t
                       join oceanbase.__all_database d
                         on d.database_id = t.database_id
                       where d.database_name = 'ai_column_generated_key'
                         and t.table_name = 'docs');
commit;

let $retry = 150;
let $ready = 0;
while ($retry)
{
  let $ready = `select count(*) = 1 from ai_column_generated_key.docs
    where content = 'generated-single' and result = concat('mock:', content)`;
  if ($ready == 1)
  {
    let $retry = 0;
  }
  if ($ready == 0)
  {
    --sleep 0.1
    dec $retry;
  }
}
eval select $ready = 1 as generated_key_single_published;

# 2. One multi-row VALUES list that omits the auto-increment key: every row is
#    queued under its own generated key and publishes into its own row.
start transaction;
insert into ai_column_generated_key.docs(content)
values ('generated-batch-a'), ('generated-batch-b'), ('generated-batch-c');
select count(*) = 3 as generated_key_batch_task_keys
from oceanbase.__all_ai_column_task task
join ai_column_generated_key.docs row_view
  on task.rowkey_predicate = concat('`id` = ', row_view.id)
where row_view.content like 'generated-batch-%'
  and task.table_id = (select t.table_id from oceanbase.__all_table t
                       join oceanbase.__all_database d
                         on d.database_id = t.database_id
                       where d.database_name = 'ai_column_generated_key'
                         and t.table_name = 'docs');
commit;

let $retry = 150;
let $ready = 0;
while ($retry)
{
  let $ready = `select count(*) = 3 from ai_column_generated_key.docs
    where content like 'generated-batch-%' and result = concat('mock:', content)`;
  if ($ready == 1)
  {
    let $retry = 0;
  }
  if ($ready == 0)
  {
    --sleep 0.1
    dec $retry;
  }
}
eval select $ready = 1 as generated_key_batch_published;

# 3. A rolled back INSERT leaves neither a row nor an orphan task, and never
#    reaches the model.
start transaction;
insert into ai_column_generated_key.docs(content) values ('generated-rollback-value');
select count(*) = 1 as generated_key_rollback_task_visible
from oceanbase.__all_ai_column_task task
join ai_column_generated_key.docs row_view
  on task.rowkey_predicate = concat('`id` = ', row_view.id)
where row_view.content = 'generated-rollback-value'
  and task.table_id = (select t.table_id from oceanbase.__all_table t
                       join oceanbase.__all_database d
                         on d.database_id = t.database_id
                       where d.database_name = 'ai_column_generated_key'
                         and t.table_name = 'docs');
rollback;
select count(*) = 0 as generated_key_rollback_row_gone
from ai_column_generated_key.docs where content = 'generated-rollback-value';
select count(*) = 0 as generated_key_rollback_no_orphan_task
from oceanbase.__all_ai_column_task task
left join ai_column_generated_key.docs row_view
  on task.rowkey_predicate = concat('`id` = ', row_view.id)
where task.table_id = (select t.table_id from oceanbase.__all_table t
                       join oceanbase.__all_database d
                         on d.database_id = t.database_id
                       where d.database_name = 'ai_column_generated_key'
                         and t.table_name = 'docs')
  and row_view.id is null;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py assert 19134 no-rollback-value

# 4. An explicit primary key value keeps being queued with that value.
start transaction;
insert into ai_column_generated_key.docs(id, content) values (900001, 'generated-explicit');
select count(*) = 1 as generated_key_explicit_task_key
from oceanbase.__all_ai_column_task task
join ai_column_generated_key.docs row_view
  on task.rowkey_predicate = concat('`id` = ', row_view.id)
where row_view.id = 900001
  and task.table_id = (select t.table_id from oceanbase.__all_table t
                       join oceanbase.__all_database d
                         on d.database_id = t.database_id
                       where d.database_name = 'ai_column_generated_key'
                         and t.table_name = 'docs');
commit;

let $retry = 150;
let $ready = 0;
while ($retry)
{
  let $ready = `select count(*) = 1 from ai_column_generated_key.docs
    where id = 900001 and result = concat('mock:', content)`;
  if ($ready == 1)
  {
    let $retry = 0;
  }
  if ($ready == 0)
  {
    --sleep 0.1
    dec $retry;
  }
}
eval select $ready = 1 as generated_key_explicit_published;

# 5. Every inserted row above is ready, so the strict read precondition holds
#    for the whole table: no row is stuck without a queued task.
let $retry = 150;
let $ready = 0;
while ($retry)
{
  let $ready = `select count(*) = 5 and count(result) = 5
    from ai_column_generated_key.docs`;
  if ($ready == 1)
  {
    let $retry = 0;
  }
  if ($ready == 0)
  {
    --sleep 0.1
    dec $retry;
  }
}
eval select $ready = 1 as generated_key_all_rows_ready;
--exec python3 mysql_test/test_suite/ai_column/include/ai_column_mock.py stop 19134
set session ai_column_strict_read = on;
select count(*) as generated_key_rows,
       count(result) as generated_key_ready_rows
from ai_column_generated_key.docs;
set session ai_column_strict_read = off;
drop database ai_column_generated_key;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('generated_key_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('generated_key_model');
