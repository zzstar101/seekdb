set @rank = ai_rerank('rerank_reg', 'query', '["aaaa", "b", "cccc", "ddd"]');
select json_extract(@rank, '$[*].index') as ranked_indices;
ranked_indices
[0, 2, 3, 1]
set @null_key_rank = ai_rerank('rerank_reg', 'query', '["aaaa", "b", "cccc", "ddd"]', null);
select json_length(@null_key_rank) as count,
json_extract(@null_key_rank, '$[*].index') as ranked_indices,
cast(@null_key_rank as char) = cast(@rank as char) as same_as_omitted_key;
