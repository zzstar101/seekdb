4	[0, 2, 3, 1]	1
select cast(ai_rerank('rerank_reg', 'query', '["aaaa", "b", "cccc", "ddd"]', cast(null as char)) as char)
= cast(@rank as char) as typed_null_key_matches_omitted;
typed_null_key_matches_omitted
1
