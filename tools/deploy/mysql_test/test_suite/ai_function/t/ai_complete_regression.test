connection default;
--exec python3 mysql_test/test_suite/ai_function/include/ai_protocol_mock.py start 19126
--disable_query_log
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('complete_regression_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('complete_regression');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('complete_regression', '{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('complete_regression_ep', '{"ai_model_name":"complete_regression","url":"http://127.0.0.1:19126/v1/chat/completions","access_key":"test-key","provider":"openai"}');
--enable_query_log
select ai_complete('complete_regression', 'hello', null) = 'mock:hello' as null_config_ok;
select ai_complete('complete_regression', 'hello', json_object('temperature', 0.2, 'max_tokens', 16)) = 'mock:hello' as json_config_ok;
select ai_complete('complete_regression', 'hello') = 'mock:hello' as absent_config_ok;
select ai_complete('complete_regression', repeat('世', 30000), '{}') = concat('mock:', repeat('世', 30000)) as long_prompt_ok;
--error 1210
select ai_complete('complete_regression', 'hello', json_array(1));
--error 1210
select ai_complete('complete_regression', 'hello', '[]');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('complete_regression_ep', '{"url":"http://127.0.0.1:19126/config/completions"}');
select ai_complete('complete_regression', 'hello', json_object('temperature', 0.2, 'max_tokens', 16)) = 'mock:hello' as request_config_ok;
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('complete_regression_ep', '{"url":"http://127.0.0.1:19126/empty/completions"}');
--error 4070
select ai_complete('complete_regression', 'hello');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('complete_regression_ep', '{"url":"http://127.0.0.1:19126/null/completions"}');
--error 4070
select ai_complete('complete_regression', 'hello');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('complete_regression_ep', '{"url":"http://127.0.0.1:19126/number/completions"}');
--error 4070
select ai_complete('complete_regression', 'hello');
call DBMS_AI_SERVICE.ALTER_AI_MODEL_ENDPOINT('complete_regression_ep', '{"url":"http://127.0.0.1:19126/missing/completions"}');
--error 4070
select ai_complete('complete_regression', 'hello');
--disable_query_log
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('complete_regression_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('complete_regression');
--exec python3 mysql_test/test_suite/ai_function/include/ai_protocol_mock.py stop 19126
--enable_query_log
