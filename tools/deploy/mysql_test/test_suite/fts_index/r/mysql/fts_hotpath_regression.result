== 13. a table with no user primary key keeps the integer doc id comparison ==
create table fts_nopk (title varchar(128), body text, fulltext index fti(title, body) with parser beng) default charset utf8mb4 collate utf8mb4_general_ci;
insert into fts_nopk values ('tag', 'alpha'), ('tag', 'bravo'), ('tag', 'alpha bravo'), ('tag', 'charlie');
select count(*) as c from fts_nopk where match(title, body) against('alpha');
c
2
select count(*) as c from fts_nopk where match(title, body) against('alpha bravo');
c
3
select count(*) as c from fts_nopk where match(title, body) against('+alpha +bravo' in boolean mode);
c
1
select count(*) as c from fts_nopk where match(title, body) against('delta');
c
0
== 14. clean up ==
drop database fts_hotpath_reg;
