drop database if exists fts_ik_reg;
create database fts_ik_reg;
use fts_ik_reg;
set ob_query_timeout = 10000000000;
create table memo (id BIGINT AUTO_INCREMENT, title VARCHAR(100), body TEXT, FULLTEXT INDEX fti(title, body));
insert into memo (title, body) values ('电影评论', '昨晚看的一部电影非常感人，让我思考了很多。');
insert into memo (title, body) values ('Security Audit', 'Completed the annual security audit.');
result_format: 4

select instr(tokenize('hello world'), 'world') > 0 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select instr(tokenize('hello world'), 'hell') = 0 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select length(tokenize('hello world')) > 2 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select instr(tokenize('HELLO'), 'hello') > 0 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select instr(tokenize('HELLO'), 'HELLO') = 0 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select length(tokenize('中文abc123，测试。')) > 2 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select length(tokenize('A-1 B.2 C_3 x@y.com 100,000')) > 2 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select length(tokenize(repeat('昨晚看的一部电影非常感人', 100))) > 2 as ok;
+----+
| ok |
+----+
|  1 |
+----+
select count(*) from memo where match(body) against ('audit');
+----------+
| count(*) |
+----------+
|        1 |
+----------+
select count(*) from memo where match(body) against ('nothinghere');
+----------+
| count(*) |
+----------+
|        0 |
+----------+
drop database fts_ik_reg;
