SET SESSION enable_file_sql = ON;
DESCRIBE SELECT * FROM read_csv('/tmp/seekdb-file-describe-regression.csv');
column_name	column_type	null	key	default	extra
id	BIGINT	NO	NULL	NULL	NULL
name	VARCHAR	NO	NULL	NULL	NULL
score	DOUBLE	NO	NULL	NULL	NULL
active	BOOLEAN	NO	NULL	NULL	NULL
day	DATE	YES	NULL	NULL	NULL
created	DATETIME	YES	NULL	NULL	NULL
empty	NULL	YES	NULL	NULL	NULL
DESC SELECT name AS label, id AS identifier FROM read_csv('/tmp/seekdb-file-describe-regression.csv') WHERE id < 0;
column_name	column_type	null	key	default	extra
label	VARCHAR	NO	NULL	NULL	NULL
identifier	BIGINT	NO	NULL	NULL	NULL
SET SESSION enable_file_sql = OFF;
